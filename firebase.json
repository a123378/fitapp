{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "*.bat", "README.md", "firestore.rules", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
